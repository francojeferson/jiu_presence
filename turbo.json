{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    // `outputs` fica vazio por padrão e é declarado só onde a tarefa
    // realmente escreve arquivo. A maioria dos pacotes não escreve nada: os
    // de biblioteca são consumidos como código TypeScript (`exports` aponta
    // para `src/index.ts`), então `build` neles é `tsc --noEmit` e `test` é
    // `vitest run` sem cobertura. Declarar saída que não existe faz o turbo
    // procurar artefato fantasma e avisar a cada execução.
    //
    // Nas tarefas por pacote o `dependsOn` vai repetido de propósito:
    // configuração por pacote SUBSTITUI a tarefa base em vez de estender, e
    // omitir zera o `^build`, soltando a ordem do grafo.
    "build": {
      "dependsOn": ["^build"]
    },
    "@jiupresence/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@jiupresence/domain#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
