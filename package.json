{
  "name": "jiupresence",
  "private": true,
  "version": "0.1.0",
  "description": "JiuPresence — controle de presença para academia de jiu-jitsu. PWA offline-first com Arquitetura Limpa e DDD.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "arch": "depcruise --config .dependency-cruiser.cjs packages apps",
    "e2e": "pnpm --filter @jiupresence/web e2e"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "dependency-cruiser": "^16.4.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
