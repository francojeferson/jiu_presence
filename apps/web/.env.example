# JiuPresence — variáveis de ambiente do app web
#
# Copie este arquivo para .env.local e preencha com os valores do SEU projeto.
# .env.local está no .gitignore e NUNCA deve ser comitado (RF-36).
#
# O projeto Flutter legado tinha credenciais placeholder dentro do código-fonte,
# em lib/services/supabase_service.dart. Este projeto não repete isso:
# nenhum segredo entra no repositório.

# URL do projeto Supabase. Painel > Project Settings > API > Project URL.
# Use região South America (São Paulo).
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima (publishable) do Supabase. Painel > Project Settings > API > anon public.
# Esta chave é pública por desenho: a proteção real vem da RLS, que nega por padrão (RF-08).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-aqui
